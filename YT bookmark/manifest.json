{
    "name": "My YT bookmark",
    "version": "1.0",
    "description": "A simple chrome extension to bookmark youtube videos",
    "permissions": ["storage", "tabs"],
    "host_permissions": ["https://*.youtube.com/*"],
    "background": {
        "service_worker": "background.js"
    },

    "content_scripts": [
        {
            "matches": ["https://*.youtube.com/*"],
            "js": ["contentScript.js"]
        }
    ],
    "comment": "unfinished part, need to add icons and other",
    "web_accessible_resources": [
        {
            "resources": [
                "assets/star.png",
                "assets/play-button.png",
                "assets/delete.png"
            ]
        }
    ]
}