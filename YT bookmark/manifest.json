{
    "name": "My YT bookmark",
    "version": "1.0",
    "description": "A simple chrome extension to bookmark youtube videos",
    "permissions": ["storage", "tabs"],
    "host_permissions": ["https://*.youtube.com/*"],
    "background": {
        "service_worker": "background.js"
    },

    "content_scripts": [
        {
            "matches": ["https://*.youtube.com/*"],
            "js": ["contentScript.js"]
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "assets/star.png",
                "assets/save.png",
                "assets/bookmark.png",
                "assets/play-button.png",
                "assets/delete.png"
            ],
            "matches": ["https://*.youtube.com/*"]
        }
    ],
    "action": {
        "default_icon": {
            "16": "assets/ext-bmk.png",
            "24": "assets/ext-bmk.png",
            "32": "assets/ext-bmk.png" 
        },
        "default_title": "My YT",
        "default_popup": "popup.html"
    },
    "manifest_version": 3
}